% Shortcut for notation
\newcommand{\code}{\mathbf{x}_{t}}               % The frame to code
\newcommand{\sysoutput}{\hat{\mathbf{x}}_t}      % The decoded frame
\newcommand{\pastref}{\hat{\mathbf{x}}_{p}}      % The past reference
\newcommand{\futureref}{\hat{\mathbf{x}}_{f}}    % The future reference
\newcommand{\pastflow}{\mathbf{v}_{p}}           % Optical flow for the past* reference
\newcommand{\futureflow}{\mathbf{v}_{f}}         % Optical flow for the future reference
\newcommand{\pred}{\tilde{\mathbf{x}}_t}         % The temporal prediction
\newcommand{\bbeta}{\boldsymbol{\beta}}          % Bold beta
\newcommand{\balph}{\boldsymbol{\alpha}}         % Bold alpha


\newcommand{\img}{\mathbf{x}}
\newcommand{\sysout}{\hat{\img}}
\newcommand{\latent}{\mathbf{y}}
\newcommand{\qlatent}{\hat{\latent}}
\newcommand{\synthparam}{\boldsymbol{\theta}}
\newcommand{\armparam}{\boldsymbol{\psi}}
\newcommand{\synthmlp}{f_{\synthparam}}
\newcommand{\armmlp}{p_{\armparam}}
\newcommand{\qsteparm}{\Delta_{\armparam}}
\newcommand{\qstepsynth}{\Delta_{\synthparam}}
\newcommand{\upparam}{\boldsymbol{\upsilon}}
\newcommand{\upsample}{f_{\upparam}}
\newcommand{\analysisparam}{\boldsymbol{\alpha}}
\newcommand{\analysis}{f_{\analysisparam}}



% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=darkblue}

% Headline
\setbeamercolor{headline}{fg=lightgray,bg=customblue!90}
\setbeamercolor{headline rule}{bg=customblue!70}

% Block
\setbeamercolor{block title}{fg=customred,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=customred,bg=customblue!20}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=customblue!20}

% Example Block
\setbeamercolor{block example title}{fg=customred,bg=lightgray}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=customred}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}
